 using android::base::SetDefaultTag;
 
+// Temporary Sabrina bootstrap diagnostics only. No activation checks are bypassed.
+void SabrinaBootstrapDiagnosticLogger(android::base::LogId id,
+    android::base::LogSeverity severity, const char* tag, const char* file,
+    unsigned int line, const char* message) {
+  android::base::KernelLogger(id, severity, tag, file, line, message);
+
+  // Use an explicit priority for a clearly labelled diagnostic copy. The retained
+  // console from the first test omitted ordinary INFO/ERROR messages.
+  std::string text = std::string("APEX_BOOTSTRAP_DIAG ") +
+                     (tag != nullptr ? tag : "apexd") + ": " + message;
+  if (text.size() > 900) text.resize(900);
+  const std::string kernel_record = "<0>" + text + "\n";
+  int fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+  if (fd >= 0) {
+    (void)write(fd, kernel_record.data(), kernel_record.size());
+    close(fd);
+  }
+
+  // Exact pmsg wire format, already independently retention-tested on this device.
+  struct __attribute__((packed)) Header {
+    uint8_t magic;
+    uint16_t length;
+    uint16_t uid;
+    uint16_t pid;
+    uint8_t log_id;
+    uint16_t tid;
+    uint32_t seconds;
+    uint32_t nanoseconds;
+  };
+  static_assert(sizeof(Header) == 18);
+  constexpr char diagnostic_tag[] = "APEX_BOOTSTRAP_DIAG";
+  const uint8_t priority = severity >= android::base::ERROR ? 6 : 4;
+  struct timespec now = {};
+  clock_gettime(CLOCK_REALTIME, &now);
+  const Header header = {static_cast<uint8_t>('l'),
+      static_cast<uint16_t>(sizeof(Header) + 1 + sizeof(diagnostic_tag) + text.size() + 1),
+      static_cast<uint16_t>(getuid()), static_cast<uint16_t>(getpid()), 0,
+      static_cast<uint16_t>(gettid()), static_cast<uint32_t>(now.tv_sec),
+      static_cast<uint32_t>(now.tv_nsec)};
+  // One write is important: this kernel locks pmsg per write, not per writev.
+  // Separate vectors could interleave with another logging thread's record.
+  std::string pmsg_record(reinterpret_cast<const char*>(&header), sizeof(header));
+  pmsg_record.push_back(static_cast<char>(priority));
+  pmsg_record.append(diagnostic_tag, sizeof(diagnostic_tag));
+  pmsg_record.append(text);
+  pmsg_record.push_back('\0');
+  fd = open("/dev/pmsg0", O_WRONLY | O_CLOEXEC | O_NONBLOCK);
+  if (fd >= 0) {
+    (void)write(fd, pmsg_record.data(), pmsg_record.size());
+    close(fd);
+  }
+}
