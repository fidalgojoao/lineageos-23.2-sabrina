diff --git a/services/core/java/com/android/server/pm/PrivacyMetadataPolicy.java b/services/core/java/com/android/server/pm/PrivacyMetadataPolicy.java
new file mode 100644
index 000000000..55dc1743b
--- /dev/null
+++ b/services/core/java/com/android/server/pm/PrivacyMetadataPolicy.java
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.pm;
+
+import java.util.function.BiConsumer;
+
+/** SDK-supported collection opt-outs; does not change Firebase messaging/auth defaults. */
+final class PrivacyMetadataPolicy {
+    private PrivacyMetadataPolicy() {}
+
+    static void apply(BiConsumer<String, Boolean> putBoolean) {
+        putBoolean.accept("firebase_analytics_collection_deactivated", true);
+        putBoolean.accept("firebase_performance_collection_deactivated", true);
+        putBoolean.accept("firebase_crashlytics_collection_enabled", false);
+        putBoolean.accept("google_analytics_adid_collection_enabled", false);
+        putBoolean.accept("google_analytics_default_allow_ad_personalization_signals", false);
+    }
+}
diff --git a/services/core/java/com/android/server/recoverysystem/FirmwareOtaPolicy.java b/services/core/java/com/android/server/recoverysystem/FirmwareOtaPolicy.java
new file mode 100644
index 000000000..a649e0b5d
--- /dev/null
+++ b/services/core/java/com/android/server/recoverysystem/FirmwareOtaPolicy.java
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+package com.android.server.recoverysystem;
+
+/** Recovery OTA policy for the custom Sabrina image; unrelated to APK/APEX updates. */
+final class FirmwareOtaPolicy {
+    private FirmwareOtaPolicy() {}
+
+    static boolean blocksRecoveryCommand(boolean firmwareOtaBlocked, String command) {
+        if (!firmwareOtaBlocked || command == null) {
+            return false;
+        }
+        for (String argument : command.split("\n")) {
+            if (argument.equals("--update_package") || argument.startsWith("--update_package=")) {
+                return true;
+            }
+            // Stock recovery's factory reset also resets env, which relocks this device.
+            // Userdata must be wiped with fastboot -w instead.
+            if (argument.equals("--wipe_data") || argument.equals("--prompt_and_wipe_data")) {
+                return true;
+            }
+        }
+        return false;
+    }
+}
