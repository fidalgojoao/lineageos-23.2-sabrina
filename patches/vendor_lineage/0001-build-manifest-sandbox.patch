diff --git a/build/tasks/build-manifest_xml.mk b/build/tasks/build-manifest_xml.mk
index 5f54967..3885529 100644
--- a/build/tasks/build-manifest_xml.mk
+++ b/build/tasks/build-manifest_xml.mk
@@ -16,9 +16,17 @@ ifdef MANIFEST_EXCLUDES
 MANIFEST_EXCLUDES := |$(MANIFEST_EXCLUDES)
 endif
 
+# Sabrina: Repo updates configuration caches; prepare the pinned manifest before
+# entering Ninja's read-only sandbox and only read/filter it in the build rule.
+ifeq ($(TARGET_PRODUCT),lineage_gsi_sabrina16)
+$(INSTALLED_BUILD_MANIFEST_XML_TARGET): $(OUT_DIR)/sabrina-source-manifest.xml
+	mkdir -p $(dir $@)
+	grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" $< > $@
+else
 $(INSTALLED_BUILD_MANIFEST_XML_TARGET):
 	mkdir -p $(dir $@)
 	REPO_TRACE=0 python3 .repo/repo/repo manifest -o - -r | grep -Ev "proprietary_$(MANIFEST_EXCLUDES)" > $@
+endif
 
 .PHONY: build-manifest.xml
 build-manifest.xml: $(INSTALLED_BUILD_MANIFEST_XML_TARGET)
